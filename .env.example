# Database Configuration
# XAMPP default MariaDB is 10.4 — Django 6 needs 10.6+ unless DB_ALLOW_OLD_MARIADB=true
# For quick local dev without MySQL: DB_ENGINE=django.db.backends.sqlite3
# Requires mysqlclient OR pymysql in the SAME venv as runserver:
#   python -m pip install mysqlclient PyMySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=MKUU_WA_MKOA
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_ALLOW_OLD_MARIADB=true

# Resilience — auto-fallback when XAMPP/MySQL is down
DB_FALLBACK_ENABLED=true
DB_FALLBACK_NAME=fallback_db.sqlite3
# DB_FORCE_FALLBACK=true
# MYSQL_DUMP_BIN=C:\xampp\mysql\bin\mysqldump.exe

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# --- ngrok (public HTTPS tunnel to local runserver) ---
# 1) Terminal A: python manage.py runserver 8000
# 2) Terminal B: .\scripts\ngrok-dev.ps1   (or: ngrok http 127.0.0.1:8000)
# 3) Copy the https URL ngrok prints; update when the subdomain changes:
# CSRF_TRUSTED_ORIGINS=https://your-subdomain.ngrok-free.dev
# NGROK_URL=https://your-subdomain.ngrok-free.dev
# After changing ngrok URL: restart Django (runserver)
# Do NOT use: ngrok http 8000 --host-header=rewrite  (causes CSRF 403)
# ERR_NGROK_8012 / 502 = Django not running or wrong port

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-password

# SMS Configuration
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=MKUUWA

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=your-shortcode
MPESA_ENV=sandbox

# Tigo Pesa Configuration
TIGO_API_KEY=your-tigo-api-key

# Airtel Money Configuration
AIRTEL_API_KEY=your-airtel-api-key

# OpenRouter AI (chatbot assistant)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_SITE_NAME=AMCOS AI
